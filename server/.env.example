# Copy this file to .env and fill in real values. Never commit .env.
PORT=4000
# localhost on your computer, bullas.in on the live server.
ROOT_DOMAIN=localhost
# Signs login tokens. Generate your own, and use a different one on the live server:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=PUT_A_LONG_RANDOM_VALUE_HERE
MONGODB_URI="mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/bullas?retryWrites=true&w=majority"

# --- Custom domains (Module 9) ---
# What customers point www.theirdomain.com at with a CNAME record.
CNAME_TARGET=sites.bullas.in
# Your server's Elastic IP, for customers' main domains (A record). Leave empty locally.
SERVER_IP=

# --- Two-factor login (Module 11) ---
# Encrypts 2FA secrets. Losing it means everyone sets up 2FA again, so back it up.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TWO_FACTOR_KEY=
# Optional on your computer: true makes 2FA required for staff, as it always is on the live server.
# TWO_FACTOR_REQUIRED=true

# --- Live server only ---
# Set these on the AWS server; leave them out on your computer.
# NODE_ENV=production   makes login cookies HTTPS-only
# HOST=127.0.0.1        lets only Caddy reach Node
# TRUST_PROXY=true      reads visitors' real IPs from Caddy
